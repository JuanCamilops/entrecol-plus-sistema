# Copia este archivo como .env y ajusta los valores
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=proyecto_bd

# Clave para firmar la sesión (genera una con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia-esta-clave

MAX_INTENTOS_FALLIDOS=3
SESION_MINUTOS=30
MAX_MB_ARCHIVO=20

# Captcha: local (sin internet) o recaptcha (Google reCAPTCHA v2)
CAPTCHA_MODO=local
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
